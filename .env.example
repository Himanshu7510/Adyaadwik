# Copy this file to .env and change the values.
PORT=3000
# Long random string — used to sign admin login sessions
SESSION_SECRET=replace-with-a-long-random-string
# Set to true once the site runs on https
COOKIE_SECURE=false
# First admin account (only used the very first time the site starts)
ADMIN_EMAIL=admin@avyaadwik.com
ADMIN_PASSWORD=Avyaadwik@2026
# Optional: keep data and uploads outside the app folder
# DATA_DIR=/var/avyaadwik/data
# UPLOAD_DIR=/var/avyaadwik/uploads
