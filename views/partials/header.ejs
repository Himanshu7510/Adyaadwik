<%- include('head') %>
<% if (s.announcement) { %>
<div class="announce"><% if (s.announcementLink) { %><a href="<%= s.announcementLink %>"><%= s.announcement %></a><% } else { %><%= s.announcement %><% } %></div>
<% } %>
<% if (s.socialHeader && (social.length || s.phone || s.email)) { %>
<div class="topbar">
  <div class="wrap topbar-inner">
    <div class="topbar-contact">
      <% if (s.phone) { %><a href="tel:+<%= h.digits(s.phone) %>" data-track="call"><svg class="ic"><use href="#i-phone"/></svg><%= s.phone %></a><% } %>
      <% if (s.email) { %><a href="mailto:<%= s.email %>"><svg class="ic"><use href="#i-mail"/></svg><%= s.email %></a><% } %>
      <% if (s.hours) { %><span class="topbar-hours"><%= s.hours %></span><% } %>
    </div>
    <%- include('social', { cls: 'social-top' }) %>
  </div>
</div>
<% } %>
<header class="site-header<%= locals.overlay ? ' is-overlay' : '' %>" id="top">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="<%= s.siteName %> home">
      <% if (s.logo) { %>
        <img src="<%= s.logo %>" alt="<%= s.siteName %>" class="brand-logo">
      <% } else { %>
        <img src="/public/img/monogram.png" alt="" class="brand-mark" width="52" height="37">
        <span class="brand-word"><%= s.siteName %></span>
      <% } %>
    </a>
    <nav class="main-nav" id="mainNav" aria-label="Main">
      <% menu.forEach(m => { const active = m.href !== '/' && path.startsWith(m.href.split('?')[0]) && (!m.href.includes('?') || req.originalUrl.includes(m.href.split('?')[1])); %>
        <a href="<%= m.href %>"<%= active ? ' aria-current=page' : '' %>><%= m.label %></a>
      <% }) %>
      <div class="nav-mobile-extra">
        <div class="nav-mobile-btns">
          <% if (s.phone) { %><a class="btn btn-ink" href="tel:+<%= h.digits(s.phone) %>" data-track="call"><svg class="ic"><use href="#i-phone"/></svg>Call us</a><% } %>
          <% if (s.whatsapp) { %><a class="btn btn-wa" href="https://wa.me/<%= h.digits(s.whatsapp) %>" target="_blank" rel="noopener" data-track="whatsapp"><svg class="ic"><use href="#i-whatsapp"/></svg>WhatsApp</a><% } %>
        </div>
        <% const cta2 = h.lines(s.headerCta)[0]; if (cta2) { %><a class="btn btn-gold btn-block" href="<%= cta2[1] %>"><%= cta2[0] %></a><% } %>
        <%- include('social', { cls: 'social-nav' }) %>
      </div>
    </nav>
    <div class="header-actions">
      <% if (s.phone) { %><a class="header-phone" href="tel:+<%= h.digits(s.phone) %>" aria-label="Call <%= s.phone %>" data-track="call"><svg class="ic"><use href="#i-phone"/></svg><span><%= s.phone %></span></a><% } %>
      <% const cta = h.lines(s.headerCta)[0]; if (cta) { %><a class="btn btn-ink btn-sm header-cta" href="<%= cta[1] %>"><%= cta[0] %></a><% } %>
      <button class="nav-toggle" type="button" aria-controls="mainNav" aria-expanded="false" aria-label="Open menu"><svg class="ic ic-open"><use href="#i-menu"/></svg><svg class="ic ic-close"><use href="#i-x"/></svg></button>
    </div>
  </div>
</header>
<main id="content">
