<%- include('../partials/header') %>
<%- include('../partials/pagehead', { title: s.aboutPageHeading || 'About us', image: s.aboutPageBanner, crumbs: [['About']] }) %>
<section class="section">
  <div class="wrap about-page">
    <div class="prose prose-lg"><%- s.aboutPageBody %></div>
    <aside class="mv">
      <% if (s.mission) { %><div><h2 class="h3">Mission</h2><p><%= s.mission %></p></div><% } %>
      <% if (s.vision) { %><div><h2 class="h3">Vision</h2><p><%= s.vision %></p></div><% } %>
    </aside>
  </div>
</section>
<% const stats = h.lines(s.stats); if (stats.length) { %><section class="stats stats-static"><div class="wrap stats-row"><% stats.forEach(([v, l]) => { %><div class="stat"><strong><%= v %></strong><span><%= l %></span></div><% }) %></div></section><% } %>
<% const values = h.lines(s.values); if (values.length) { %>
<section class="section">
  <div class="wrap"><h2>What we stand by</h2>
    <div class="values"><% values.forEach(([t, d]) => { %><div><h3><%= t %></h3><p><%= d %></p></div><% }) %></div>
  </div>
</section>
<% } %>
<% if (team.length) { %>
<section class="section section-stone">
  <div class="wrap"><h2>Leadership</h2>
    <div class="team"><% team.forEach(m => { %>
      <article class="member">
        <% if (m.photo) { %><img src="<%= m.photo %>" alt="<%= m.name %>" loading="lazy"><% } else { %><span class="avatar avatar-lg"><%= h.initials(m.name) %></span><% } %>
        <h3><%= m.name %></h3><p class="member-role"><%= m.designation %></p><p><%= m.bio %></p>
        <% if (m.linkedin) { %><a href="<%= m.linkedin %>" target="_blank" rel="noopener" aria-label="LinkedIn"><svg class="ic"><use href="#i-linkedin"/></svg></a><% } %>
      </article>
    <% }) %></div>
  </div>
</section>
<% } %>
<%- include('../partials/cta') %>
<%- include('../partials/footer') %>
