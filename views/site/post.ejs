<%- include('../partials/header') %>
<article>
  <header class="post-head wrap narrow-wrap">
    <nav class="crumbs crumbs-dark"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/blog">Blog</a></nav>
    <p class="bcard-meta"><%= p.category %><% if (p.date) { %> <span aria-hidden="true">/</span> <%= h.fmtDate(p.date) %><% } %><% if (p.author) { %> <span aria-hidden="true">/</span> <%= p.author %><% } %></p>
    <h1><%= p.title %></h1>
    <% if (p.excerpt) { %><p class="lede-dark"><%= p.excerpt %></p><% } %>
  </header>
  <% if (p.cover) { %><figure class="wrap post-cover"><img src="<%= p.cover %>" alt="" onerror="this.parentNode.remove()"></figure><% } %>
  <div class="wrap narrow-wrap prose prose-lg post-body"><%- p.body %></div>
  <% if (h.tags(p.tags).length) { %><div class="wrap narrow-wrap chips"><% h.tags(p.tags).forEach(t => { %><span><%= t %></span><% }) %></div><% } %>
  <div class="wrap narrow-wrap post-share"><%- include('../partials/share', { title: p.title }) %></div>
</article>
<% if (more.length) { %><section class="section section-stone"><div class="wrap"><h2>Keep reading</h2><div class="grid-3"><% more.forEach(x => { %><%- include('../partials/postcard', { p: x }) %><% }) %></div></div></section><% } %>
<%- include('../partials/cta') %>
<%- include('../partials/footer') %>
